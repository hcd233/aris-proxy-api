#!/bin/sh
# Aris trace client installer — self-contained, no ticket required.
# Generated by aris-proxy-api; server host is embedded below.
# The script only downloads and installs the binary; configuration is
# handled by the interactive wizard: aris init
set -eu

host='{{.Host}}'
gh_base='https://github.com/hcd233/aris-proxy-api/releases/latest/download'

# --- preflight ---
command -v curl >/dev/null 2>&1 || { echo "curl is required" >&2; exit 1; }
command -v tar >/dev/null 2>&1 || { echo "tar is required" >&2; exit 1; }

# --- platform detection ---
case "$(uname -s)-$(uname -m)" in
  Darwin-x86_64)             os=darwin; arch=amd64 ;;
  Darwin-arm64)              os=darwin; arch=arm64 ;;
  Linux-x86_64)              os=linux;  arch=amd64 ;;
  Linux-aarch64|Linux-arm64) os=linux;  arch=arm64 ;;
  *) echo "Unsupported platform: $(uname -s)/$(uname -m)" >&2; exit 1 ;;
esac

# --- download archive ---
aris_bin="$HOME/.aris/bin/aris"
mkdir -p -m 0700 "$(dirname "$aris_bin")"
tmp=$(mktemp "${TMPDIR:-/tmp}/aris.XXXXXX")
checksum_tmp=$(mktemp "${TMPDIR:-/tmp}/aris-checksum.XXXXXX")
trap 'rm -f "$tmp" "$checksum_tmp"' EXIT
echo "Downloading aris-$os-$arch.tar.gz..."
curl -fsSL -o "$tmp" "$gh_base/aris-$os-$arch.tar.gz"
curl -fsSL -o "$checksum_tmp" "$gh_base/aris-$os-$arch.tar.gz.sha256"
checksum=$(awk 'NF == 1 { print $1 } NF == 2 { print $1; next } { exit 1 }' "$checksum_tmp")
[ "$(printf '%s\n' "$checksum" | awk 'NF == 1 { count++ } END { print count + 0 }')" -eq 1 ] || { echo "Invalid checksum file" >&2; exit 1; }
case "$checksum" in
  (*[!0-9a-fA-F]*) echo "Invalid checksum file" >&2; exit 1 ;;
  (*) [ "$(printf '%s' "$checksum" | awk '{ print length }')" -eq 64 ] || { echo "Invalid checksum file" >&2; exit 1; } ;;
esac
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$tmp" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$tmp" | awk '{print $1}')
else
  echo "sha256sum or shasum is required" >&2
  exit 1
fi
[ "$checksum" = "$actual" ] || { echo "Checksum verification failed" >&2; exit 1; }
tar -xzf "$tmp" -C "$(dirname "$aris_bin")"
chmod 0700 "$aris_bin"
rm -f "$tmp" "$checksum_tmp"
trap - EXIT
echo "Installed to $aris_bin"

# --- run interactive setup wizard (handles the terminal itself when stdin is the curl pipe) ---
exec "$aris_bin" init --host "$host"
