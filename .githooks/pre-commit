#!/bin/sh
# Pre-commit hook: run Go checks before committing

# Path to the Go binary — override if Go is installed elsewhere, e.g. /usr/local/go/bin/go
GO_BIN="${GO_BIN:-go}"

# Allow Go to automatically download and switch to the toolchain version
# required by go.mod (e.g. go 1.25.1 when the system only has 1.22.x)
export GOTOOLCHAIN=auto

# Ensure common Go install locations are in PATH
export PATH=$PATH:/usr/local/go/bin:$HOME/go/bin:$HOME/sdk/go/bin

PASS="\033[32m[PASS]\033[0m"
FAIL="\033[31m[FAIL]\033[0m"
INFO="\033[34m[INFO]\033[0m"

fail() {
    printf "$FAIL %s\n" "$1"
    exit 1
}

# --------------------------------------------------------------------------
# 0. agent instructions symlink sync — mirror AGENTS.md to CODEBUDDY.md / CLAUDE.md
# --------------------------------------------------------------------------
printf "$INFO Running agent instructions symlink sync ...\n"

if [ -f script/sync-agent-instructions-symlinks.sh ]; then
    chmod +x script/sync-agent-instructions-symlinks.sh 2>/dev/null || true
    if ! sh script/sync-agent-instructions-symlinks.sh; then
        fail "agent instructions symlink sync failed. Please fix the issues above before committing."
    fi
    AGENTS_LINK_CHANGES=$(git status --porcelain -- CODEBUDDY.md CLAUDE.md)
    if [ -n "$AGENTS_LINK_CHANGES" ]; then
        printf "$INFO agent instructions symlinks changed after sync (auto-staging):\n"
        echo "$AGENTS_LINK_CHANGES" | sed 's/^/       /'
        echo ""
        git add CODEBUDDY.md CLAUDE.md
    fi
else
    printf "$INFO script/sync-agent-instructions-symlinks.sh not found — skipping\n"
fi
printf "$PASS agent instructions symlink sync\n"

# --------------------------------------------------------------------------
# 0b. skills symlink sync — mirror .agents/skills into IDE skill directories
# --------------------------------------------------------------------------
printf "$INFO Running skills symlink sync ...\n"

if [ -f script/sync-skills-symlinks.sh ]; then
    chmod +x script/sync-skills-symlinks.sh 2>/dev/null || true
    if ! sh script/sync-skills-symlinks.sh; then
        fail "skills symlink sync failed. Please fix the issues above before committing."
    fi
    SKILLS_CHANGES=$(git status --porcelain -- .claude/skills .codebuddy/skills .zcode/skills)
    if [ -n "$SKILLS_CHANGES" ]; then
        printf "$INFO skills symlinks changed after sync (auto-staging):\n"
        echo "$SKILLS_CHANGES" | sed 's/^/       /'
        echo ""
        git add .claude/skills .codebuddy/skills .zcode/skills
    fi
else
    printf "$INFO script/sync-skills-symlinks.sh not found — skipping\n"
fi
printf "$PASS skills symlink sync\n"

# --------------------------------------------------------------------------
# 0c. web prettier — auto-format staged web files and re-stage
#     （与 CI web-lint 的 Prettier check 同规则，避免本地提交后 CI 才发现格式问题）
# --------------------------------------------------------------------------
# 注：git pathspec 的 `web/*.ts` 不匹配嵌套路径，故先取 web/ 下全部暂存文件再按扩展名过滤
WEB_CHANGES=$(git diff --cached --name-only --diff-filter=ACMR -- web/ \
    | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|css|scss|less|md|mdx|yml|yaml)$' || true)

if [ -z "$WEB_CHANGES" ]; then
    printf "$INFO No web file changes in staging area — skipping prettier\n"
elif [ ! -d web/node_modules ]; then
    printf "$INFO web/node_modules not found — skipping prettier\n"
else
    printf "$INFO Running prettier -w ...\n"

    # cd 进 web/ 使 prettier 解析 web/ 的配置与本地依赖；路径去掉 web/ 前缀
    RELATIVE=$(printf '%s\n' "$WEB_CHANGES" | sed 's|^web/||')
    if ! ( cd web && npx prettier --write --log-level warn $RELATIVE ); then
        fail "prettier failed. Please fix the issues above before committing."
    fi

    if ! git diff --quiet -- $WEB_CHANGES; then
        printf "$INFO prettier reformatted the following files (auto-staging):\n"
        echo "$WEB_CHANGES" | sed 's/^/       /'
        echo ""
        git add $WEB_CHANGES
    fi
    printf "$PASS prettier\n"
fi

# --------------------------------------------------------------------------
# 1. Detect Go changes in staging area — skip Go checks if none
# --------------------------------------------------------------------------
GO_CHANGES=$(git diff --cached --name-only -- '*.go' 'go.mod' 'go.sum')

if [ -z "$GO_CHANGES" ]; then
    printf "$INFO No Go file changes in staging area — skipping gofmt, go mod tidy, vet, test, lint\n"
else
    # --------------------------------------------------------------------------
    # 2. gofmt — auto-format source files and re-stage changed files
    # --------------------------------------------------------------------------
    printf "$INFO Running gofmt -w ...\n"
    gofmt -w .

    if ! git diff --quiet; then
        FORMATTED=$(git diff --name-only)
        printf "$INFO gofmt reformatted the following files (auto-staging):\n"
        echo "$FORMATTED" | sed 's/^/       /'
        echo ""
        git add $FORMATTED
    fi
    printf "$PASS gofmt\n"

    # --------------------------------------------------------------------------
    # 3. go mod tidy — verify go.mod / go.sum are consistent and re-stage
    # --------------------------------------------------------------------------
    printf "$INFO Running go mod tidy...\n"
    $GO_BIN mod tidy

    if ! git diff --quiet go.mod go.sum; then
        printf "$INFO go.mod or go.sum changed after 'go mod tidy' (auto-staging):\n"
        git diff --name-only go.mod go.sum | sed 's/^/       /'
        echo ""
        git add go.mod go.sum
    fi
    printf "$PASS go mod tidy\n"

    # --------------------------------------------------------------------------
    # 4. go vet — static analysis
    # --------------------------------------------------------------------------
    printf "$INFO Running go vet ./...\n"

    if ! $GO_BIN vet ./... 2>&1; then
        fail "go vet failed. Please fix the issues above before committing."
    fi
    printf "$PASS go vet\n"

    # --------------------------------------------------------------------------
    # 5. go test — run all unit tests, block commit on any failure
    # --------------------------------------------------------------------------
    printf "$INFO Running go test -count=1 ./...\n"

    if ! $GO_BIN test -count=1 ./... 2>&1; then
        fail "go test failed. All tests must pass before committing."
    fi
    printf "$PASS go test\n"

    # --------------------------------------------------------------------------
    # 6. lint — project convention lint（cmd/lint 根命令并发执行 conv + static）
    # --------------------------------------------------------------------------
    printf "$INFO Running lint...\n"

    if ! $GO_BIN run ./cmd/lint ./... 2>&1; then
        fail "lint failed. Please fix the issues above before committing."
    fi
    printf "$PASS lint\n"
fi

# --------------------------------------------------------------------------
echo ""
printf "$PASS All checks passed. Proceeding with commit.\n"
